# Variables de entorno para el despliegue en produccion con Docker Compose
# (docker-compose.prod.yml). Copia este fichero a ".env" en la raiz del
# proyecto y ajusta los valores marcados como OBLIGATORIOS.
#
# Diferencia clave frente a backend/.env.example, model-service/.env.example
# y frontend/.env.example (pensados para ejecutar cada servicio "a mano" en
# tu maquina, con localhost): aqui los servicios se llaman unos a otros por
# el NOMBRE del servicio dentro de la red interna que crea Docker Compose
# (p. ej. "postgis", "model-service"), nunca por "localhost" - cada
# contenedor tiene su propio localhost, que no es el de los demas.

# -------- Dominio (Caddy / HTTPS) --------
# Se puede entrar de DOS formas a la vez (ver /Caddyfile):
#   - Por dominio:  https://ecoguardian.es   (Caddy pide y renueva SOLO el
#     certificado Let's Encrypt; http://ecoguardian.es redirige a https)
#   - Por IP:       http://<ip-del-servidor>  (HTTP plano: una IP no puede tener
#     certificado)
# Requisitos del dominio: registro A de ecoguardian.es (y de www) hacia la IP
# publica del servidor y puertos 80 y 443 abiertos hacia el. Si el DNS aun no
# propaga, la IP ya funciona; Caddy reintenta el certificado solo.
# Varios nombres, separados por coma y espacio:
DOMAIN=ecoguardian.es, www.ecoguardian.es

# -------- PostgreSQL / PostGIS --------
POSTGRES_DB=ecoguardian
POSTGRES_USER=ecoguardian
# OBLIGATORIO: cambia esta contrasena antes de desplegar en un servidor
# accesible desde internet.
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# -------- Backend --------
BACKEND_PORT=4000
MODEL_SERVICE_URL=http://model-service:8000

# Opcional: si se define, el backend exige la cabecera X-App-Token en
# /api/detections/analyze, /api/analysis-images y /api/stats/report (ver
# backend/src/middleware/accessControl.js). Si lo activas aqui, define el
# MISMO valor en VITE_ACCESS_TOKEN mas abajo, porque es el frontend quien
# tiene que enviar esa cabecera. Dejalo vacio para no exigir token (el
# limitador de peticiones por IP sigue activo siempre, con o sin token).
ACCESS_TOKEN=

# -------- Model service --------
MODEL_WEIGHTS_PATH=./weights/best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.90

# Cuantas inferencias deja pasar el backend A LA VEZ hacia model-service,
# sea cual sea el numero de usuarios analizando al mismo tiempo (ver
# backend/src/services/modelClient.js) - el resto espera su turno en el
# propio backend. Por defecto 2, a juego con el unico worker de uvicorn
# con el que arranca model-service (ver model-service/Dockerfile). Solo
# tiene sentido subirlo si tambien subes el numero de workers/CPU de
# model-service; si no, subirlo solo hara que las peticiones compitan
# mas entre si y tarden mas todas, no que vayan mas rapido.
MODEL_SERVICE_CONCURRENCY=2

# -------- Frontend (variables VITE_* - se usan en tiempo de BUILD, ver
# frontend/Dockerfile) --------
# Vacio a proposito: en produccion el frontend y el backend comparten un
# unico dominio detras de Caddy, asi que las llamadas a la API son
# relativas ("/api/...") en vez de a una URL absoluta con ":4000". No
# cambies esto salvo que sepas lo que haces (ver el comentario en
# frontend/src/services/api.js).
VITE_BACKEND_URL=
# Debe coincidir con ACCESS_TOKEN si has activado el token de acceso arriba.
VITE_ACCESS_TOKEN=
VITE_PNOA_WMS_URL=https://www.ign.es/wms-inspire/pnoa-ma

# -------- Sesiones y administrador --------
# JWT_SECRET: lo genera deploy.sh si lo dejas vacio (y lo guarda aqui).
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d
ADMIN_EMAIL=admin@ecoguardian.es
# Vacio: se genera una contrasena y se muestra UNA vez en los logs del backend:
#   docker compose -f docker-compose.prod.yml logs backend | grep -i -A4 bootstrap
ADMIN_PASSWORD=

# -------- URL publica y correo --------
# Con la que los usuarios abren la web; se usa en los enlaces de los correos.
APP_URL=https://ecoguardian.es
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoGuardian <no-reply@ecoguardian.es>
GOOGLE_CLIENT_ID=

# -------- Mapbox --------
# model-service (descarga la imagen de satelite) y frontend (mapas) usan el
# mismo token, pero VITE_MAPBOX_TOKEN se incrusta en el JS en el BUILD: es
# publico, usa un token restringido a tu dominio en la cuenta de Mapbox.
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=

# -------- Vuelos, areas monitorizadas, dataset (opcionales) --------
MAX_UPLOAD_MB=4096
KEEP_FLIGHT_VIDEO=false
AREA_SCHEDULER=on
AREA_SCHEDULER_INTERVAL_SECONDS=300
AREA_MAX_CELLS=400
AREA_CONCURRENCY=2
DETECTION_DEDUPE_METERS=40
DATASET_MAX_IMAGES=5000
