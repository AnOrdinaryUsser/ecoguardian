BACKEND_PORT=4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecoguardian
POSTGRES_USER=ecoguardian
POSTGRES_PASSWORD=change_me

MODEL_SERVICE_URL=http://localhost:8000
MODEL_SERVICE_CONCURRENCY=2

# Fuente de imagen por defecto para el analisis: mapbox | pnoa
DEFAULT_IMAGE_SOURCE=mapbox

# Distancia (m) a un vertedero legal registrado por debajo de la cual una
# deteccion se considera esa misma instalacion (legal) y no un vertedero ilegal.
LEGAL_FACILITY_RADIUS_METERS=300

# --- Autenticacion ---
# Pon un valor largo y aleatorio (ej: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Si lo dejas vacio se genera uno al arrancar y las sesiones se pierden al reiniciar.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Primer arranque: se crea este admin si la tabla users esta vacia. Si dejas
# ADMIN_PASSWORD vacio se genera una y se muestra una vez por consola.
ADMIN_EMAIL=admin@ecoguardian.local
ADMIN_PASSWORD=

# --- Drones ---
# Donde se guardan videos subidos y fotogramas (relativo a backend/).
UPLOADS_DIR=uploads
# Tamano maximo de subida (MB) para el video de un vuelo.
MAX_UPLOAD_MB=4096
# Si es true se conserva el video tras procesarlo (por defecto se borra para ahorrar disco).
KEEP_FLIGHT_VIDEO=false
# Dos avistamientos del mismo vuelo a menos de esta distancia (m) cuentan como el mismo vertedero.
FLIGHT_MERGE_DISTANCE_METERS=30
# ffmpeg: por defecto se usa el que trae el paquete ffmpeg-static; define esto para usar otro.
# FFMPEG_PATH=

# --- Correo (bienvenida a usuarios nuevos y recuperacion de contraseña) ---
# URL con la que los usuarios abren la web (se usa en los enlaces del correo).
APP_URL=http://localhost:5173
# Servidor SMTP. Sin SMTP_HOST no se envia nada (el texto sale por consola).
SMTP_HOST=
SMTP_PORT=587
# true para puerto 465 (TLS directo); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoGuardian <no-reply@tudominio.es>

# --- Inicio de sesion con Google / Apple (opcional) ---
# Google: ID de cliente OAuth (tipo "Aplicacion web") de Google Cloud Console.
GOOGLE_CLIENT_ID=
# Apple: Services ID y URL de retorno HTTPS registrada en Apple Developer.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
# Duracion de la sesion si se marca "Recordarme".
JWT_REMEMBER_EXPIRES_IN=30d

# --- Areas monitorizadas, tamanos y rutas (todas opcionales) ---
# Reanalisis automatico de areas: on/off y cada cuantos segundos se comprueba que areas toca.
AREA_SCHEDULER=on
AREA_SCHEDULER_INTERVAL_SECONDS=300
# Maximo de celdas por area y analisis en paralelo.
AREA_MAX_CELLS=400
AREA_CONCURRENCY=2
# Distancia (m) bajo la que dos detecciones se consideran la misma.
DETECTION_DEDUPE_METERS=40
# Maximo de imagenes en un dataset exportado.
DATASET_MAX_IMAGES=5000
# Codigos DJI para el KMZ (por defecto Mini 5 Pro; ajustalos si DJI Fly lo rechaza).
DJI_DRONE_ENUM=
DJI_DRONE_SUB_ENUM=
