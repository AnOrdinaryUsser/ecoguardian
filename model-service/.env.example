MODEL_SERVICE_PORT=8000

# Ruta al checkpoint de YOLOv8 ya entrenado (copia best.pt a model-service/weights/).
MODEL_WEIGHTS_PATH=./weights/best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.90

# --- Imagen de Mapbox (fuente con la que se entreno el modelo) ---
# Token de acceso de Mapbox (el secreto "sk." o uno "pk." con permiso de Static Images).
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/satellite-v9
# Imagen logica 640x640; con MAPBOX_RETINA=true se descarga @2x (1280x1280).
MAPBOX_IMAGE_SIZE=640
MAPBOX_RETINA=true

# Fuente por defecto: mapbox | pnoa
DEFAULT_IMAGE_SOURCE=mapbox

# --- PNOA (alternativa) ---
MODEL_TILE_SIZE=960
PNOA_WMS_URL=https://www.ign.es/wms-inspire/pnoa-ma
PNOA_LAYER=OI.OrthoimageCoverage

# Guarda cada celda analizada (original + anotada con todas las cajas y su %) para revisarlas.
SAVE_TILES=true
TILES_OUTPUT_DIR=./tiles_output
# Fraccion inferior recortada para quitar el logo/atribucion de Mapbox antes de inferir.
MAPBOX_CROP_BOTTOM=0.07
